// FairyGUI for Godot - shared code of the FairyGUI canvas_item shaders (port of the Unity FairyGUI-Image.shader
// fragment stages). Included by fairygui_image/text/bmfont/painting/blur.gdshader.
//
// Unity multi_compile keywords become bool uniforms with the same name, set by MaterialManager/NGraphics:
//   GRAYED, COLOR_FILTER (CLIPPED, SOFT_CLIPPED, ALPHA_MASK are not used: Godot clips with clip rects/clip_children).
// Blend modes: the blend equation is the render_mode of the shader variant (generated by BlendModeUtils at runtime);
// blend_op pre-transforms COLOR so the fixed Godot equation gives the Unity result (see BlendMode.cs).

uniform bool GRAYED = false;
uniform bool COLOR_FILTER = false;
uniform mat4 color_matrix = mat4(1.0);
uniform vec4 color_offset = vec4(0.0);
// 0: apply color_matrix, 1: premultiplied-alpha blend mode (Unity _ColorOption), color_matrix is ignored
uniform int color_option = 0;
// BlendModeUtils.BlendOp*: 0 none, 1 force opaque, 2 multiply, 3 screen, 4 erase, 5 mask, 6 premultiply
uniform int blend_op = 0;

vec4 fgui_effects(vec4 col)
{
	if (GRAYED)
	{
		float grey = dot(col.rgb, vec3(0.299, 0.587, 0.114));
		col.rgb = vec3(grey, grey, grey);
	}

	if (COLOR_FILTER && color_option == 0)
	{
		col = color_matrix * col + color_offset;
	}

	return col;
}

vec4 fgui_blend_op(vec4 col)
{
	if (blend_op == 1)
	{
		// One, One emulated with blend_add (src * a + dst): rgb is added unweighted
		col.a = 1.0;
	}
	else if (blend_op == 2)
	{
		// DstColor, OneMinusSrcAlpha (premultiplied) with blend_mul (dst * src): dst * (rgb * a + 1 - a)
		col.rgb = mix(vec3(1.0), col.rgb, col.a);
		col.a = 1.0;
	}
	else if (blend_op == 3)
	{
		// One, OneMinusSrcColor (premultiplied) with blend_premul_alpha (src + dst * (1 - a)):
		// per-channel (1 - src) is approximated with the average of the premultiplied color
		col.rgb *= col.a;
		col.a = (col.r + col.g + col.b) / 3.0;
	}
	else if (blend_op == 4)
	{
		// Zero, OneMinusSrcAlpha with blend_mul: dst * (1 - a)
		col = vec4(1.0 - col.a);
	}
	else if (blend_op == 5)
	{
		// Zero, SrcAlpha with blend_mul: dst * a
		col = vec4(col.a);
	}
	else if (blend_op == 6)
	{
		// One, OneMinusSrcAlpha with premultiplied output
		col.rgb *= col.a;
	}
	return col;
}

vec4 fgui_process(vec4 col)
{
	return fgui_blend_op(fgui_effects(col));
}
